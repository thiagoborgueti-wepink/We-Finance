# Copie para .env.local e preencha. Arquivos .env nunca vão para o git.
# No Vercel, estas variáveis são criadas pela integração Supabase do Marketplace.
# Localmente: `vercel env pull .env.local` (requer o ambiente Development habilitado na integração).

# Públicas (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente no servidor ou em Edge Functions. Nunca no frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Conexão direta com o Postgres (migrações, ORMs)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
